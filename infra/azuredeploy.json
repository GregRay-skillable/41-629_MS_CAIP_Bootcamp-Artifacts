{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",

  "parameters": {
    "primaryLocation": {
      "type": "string",
      "defaultValue": "centralus",
      "metadata": {
        "description": "Azure region for primary database, VM, ACR, Bastion, and migration resources."
      }
    },

    "secondaryLocation": {
      "type": "string",
      "defaultValue": "centralus",
      "metadata": {
        "description": "Azure region for the secondary database network."
      }
    },

    "applicationLocation": {
      "type": "string",
      "defaultValue": "centralus",
      "metadata": {
        "description": "Azure region for the application network and Container Apps environment."
      }
    },

    "vmAdminUsername": {
      "type": "string",
      "defaultValue": "labadmin",
      "metadata": {
        "description": "Administrator username for the Azure lab virtual machines."
      }
    },

    "vmAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Administrator password for the Azure lab virtual machines."
      }
    },

    "containerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/dotnet/samples:aspnetapp",
      "metadata": {
        "description": "Initial placeholder image for the Container App."
      }
    }
  },

  "variables": {
    "prefix": "caldova",
    "suffix": "[take(uniqueString(resourceGroup().id), 8)]",

    "tags": {
      "Application": "Caldova",
      "Environment": "Lab",
      "ManagedBy": "Skillable"
    },

    "keyVaultName": "[toLower(format('{0}{1}-kv', variables('prefix'), variables('suffix')))]",
    "codeBuildIdentityName": "[format('{0}-code-build-{1}', variables('prefix'), variables('suffix'))]",
    "codeDeploymentIdentityName": "[format('{0}-code-deploy-{1}', variables('prefix'), variables('suffix'))]",

    "keyVaultSecretsOfficerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'b86a8fe4-44ce-4948-aee5-eccb2c155cd7')]",

    "primaryDatabaseVnetName": "[format('{0}-db-primary-{1}-vnet', variables('prefix'), variables('suffix'))]",
    "vmNsgName": "[format('{0}-vm-{1}-nsg', variables('prefix'), variables('suffix'))]",

    "vmSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('primaryDatabaseVnetName'), 'snet-vms')]",
    "bastionSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('primaryDatabaseVnetName'), 'AzureBastionSubnet')]",
    "privateEndpointSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('primaryDatabaseVnetName'), 'snet-private-endpoints')]",
    "dmsSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('primaryDatabaseVnetName'), 'snet-dms')]",

    "sourceNicName": "[format('{0}-source-{1}-nic', variables('prefix'), variables('suffix'))]",
    "sourceVmName": "[format('{0}-source-{1}-vm', variables('prefix'), variables('suffix'))]",

    "testNicName": "[format('{0}-test-{1}-nic', variables('prefix'), variables('suffix'))]",
    "testVmName": "[format('{0}-test-{1}-vm', variables('prefix'), variables('suffix'))]",

    "bastionName": "[format('{0}-{1}-bas', variables('prefix'), variables('suffix'))]",
    "bastionPublicIpName": "[format('{0}-{1}-bas-pip', variables('prefix'), variables('suffix'))]",

    "registryName": "[toLower(format('{0}cr{1}', variables('prefix'), variables('suffix')))]",

    "acrPushRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '8311e382-0749-4cb8-b61a-304f252e45ec')]",
    "acrPullRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '7f951dda-4ed3-4680-a7ca-43fe172d538d')]",

    "sqlServerName": "[toLower(format('{0}sql{1}', variables('prefix'), variables('suffix')))]",
    "sqlDatabaseName": "eShop",
    "sqlPrivateDnsZoneName": "[format('privatelink{0}', environment().suffixes.sqlServerHostname)]",

    "migrationServiceName": "[format('{0}-{1}-dms', variables('prefix'), variables('suffix'))]",

    "secondaryDatabaseVnetName": "[format('{0}-db-secondary-{1}-vnet', variables('prefix'), variables('suffix'))]",
    "applicationVnetName": "[format('{0}-app-secondary-{1}-vnet', variables('prefix'), variables('suffix'))]",

    "containerAppsSubnetId": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('applicationVnetName'), 'snet-container-apps')]",

    "logAnalyticsName": "[format('{0}-application-{1}-log', variables('prefix'), variables('suffix'))]",

    "containerAppsEnvironmentName": "[format('{0}-application-{1}-cae', variables('prefix'), variables('suffix'))]",
    "containerAppName": "[format('{0}-{1}-app', variables('prefix'), variables('suffix'))]",

    "containerAppsContributorRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '358470bc-b998-42bd-ab17-a7e34c199c0f')]",

    "frontDoorProfileName": "[format('{0}-{1}-afd', variables('prefix'), variables('suffix'))]",
    "frontDoorEndpointName": "[format('{0}-{1}', variables('prefix'), variables('suffix'))]",
    "frontDoorOriginGroupName": "regional-apps",
    "frontDoorOriginName": "application",
    "frontDoorRouteName": "default",

    "frontDoorPrivateLinkRequestMessage": "[format('Caldova Front Door origin {0}/{1}/application', variables('frontDoorProfileName'), variables('frontDoorEndpointName'))]",

    "readerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
  },

  "resources": [

    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2024-11-01",
      "name": "[variables('keyVaultName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "publicNetworkAccess": "Enabled",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]"
      }
    },

    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "[variables('codeBuildIdentityName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]"
    },

    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2024-11-30",
      "name": "[variables('codeDeploymentIdentityName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]"
    },

    {
      "type": "Microsoft.KeyVault/vaults/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('keyVaultName'), guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), variables('keyVaultSecretsOfficerRoleDefinitionId')))]",
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsOfficerRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "[variables('vmNsgName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "AllowRdpFromBastion",
            "properties": {
              "priority": 100,
              "access": "Allow",
              "direction": "Inbound",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "10.0.1.0/26",
              "destinationAddressPrefix": "*"
            }
          },
          {
            "name": "AllowSshFromBastion",
            "properties": {
              "priority": 110,
              "access": "Allow",
              "direction": "Inbound",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "10.0.1.0/26",
              "destinationAddressPrefix": "*"
            }
          }
        ]
      }
    },

    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('primaryDatabaseVnetName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/20"
          ]
        },
        "subnets": [
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "10.0.1.0/26"
            }
          },
          {
            "name": "snet-vms",
            "properties": {
              "addressPrefix": "10.0.2.0/24",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('vmNsgName'))]"
              }
            }
          },
          {
            "name": "snet-private-endpoints",
            "properties": {
              "addressPrefix": "10.0.3.0/24",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          },
          {
            "name": "snet-dms",
            "properties": {
              "addressPrefix": "10.0.4.0/24"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('vmNsgName'))]"
      ]
    },

    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('registryName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "adminUserEnabled": false,
        "dataEndpointEnabled": false,
        "publicNetworkAccess": "Enabled",
        "policies": {
          "quarantinePolicy": {
            "status": "disabled"
          },
          "retentionPolicy": {
            "days": 7,
            "status": "disabled"
          },
          "trustPolicy": {
            "type": "Notary",
            "status": "disabled"
          }
        }
      }
    },

    {
      "type": "Microsoft.ContainerRegistry/registries/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('registryName'), guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeBuildIdentityName')), variables('acrPushRoleDefinitionId')))]",
      "properties": {
        "roleDefinitionId": "[variables('acrPushRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeBuildIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeBuildIdentityName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('sourceNicName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "enableAcceleratedNetworking": false,
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('vmSubnetId')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2024-05-01",
      "name": "[variables('testNicName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "enableAcceleratedNetworking": false,
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "subnet": {
                "id": "[variables('vmSubnetId')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[variables('sourceVmName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v5"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('sourceNicName'))]",
              "properties": {
                "primary": true
              }
            }
          ]
        },
        "osProfile": {
          "computerName": "lab-source",
          "adminUsername": "[parameters('vmAdminUsername')]",
          "adminPassword": "[parameters('vmAdminPassword')]",
          "windowsConfiguration": {
            "enableAutomaticUpdates": true,
            "provisionVMAgent": true,
            "patchSettings": {
              "assessmentMode": "ImageDefault",
              "enableHotpatching": false,
              "patchMode": "AutomaticByOS"
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "MicrosoftSQLServer",
            "offer": "sql2022-ws2022",
            "sku": "sqldev-gen2",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('sourceNicName'))]"
      ]
    },

    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2024-07-01",
      "name": "[variables('testVmName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "Standard_D2s_v5"
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('testNicName'))]",
              "properties": {
                "primary": true
              }
            }
          ]
        },
        "osProfile": {
          "computerName": "lab-test",
          "adminUsername": "[parameters('vmAdminUsername')]",
          "adminPassword": "[parameters('vmAdminPassword')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": false,
            "provisionVMAgent": true,
            "patchSettings": {
              "assessmentMode": "AutomaticByPlatform",
              "patchMode": "AutomaticByPlatform"
            }
          }
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "Canonical",
            "offer": "0001-com-ubuntu-server-jammy",
            "sku": "22_04-lts-gen2",
            "version": "latest"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "StandardSSD_LRS"
            }
          }
        },
        "diagnosticsProfile": {
          "bootDiagnostics": {
            "enabled": true
          }
        },
        "securityProfile": {
          "securityType": "TrustedLaunch",
          "uefiSettings": {
            "secureBootEnabled": true,
            "vTpmEnabled": true
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('testNicName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2024-05-01",
      "name": "[variables('bastionPublicIpName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard",
        "tier": "Regional"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    },

    {
      "type": "Microsoft.Network/bastionHosts",
      "apiVersion": "2024-05-01",
      "name": "[variables('bastionName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Basic"
      },
      "properties": {
        "disableCopyPaste": false,
        "enableFileCopy": false,
        "enableIpConnect": false,
        "enableKerberos": false,
        "enableShareableLink": false,
        "enableTunneling": false,
        "scaleUnits": 2,
        "ipConfigurations": [
          {
            "name": "bastion-ip-configuration",
            "properties": {
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPublicIpName'))]"
              },
              "subnet": {
                "id": "[variables('bastionSubnetId')]"
              }
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('bastionPublicIpName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Sql/servers",
      "apiVersion": "2023-08-01",
      "name": "[variables('sqlServerName')]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "administrators": {
          "administratorType": "ActiveDirectory",
          "azureADOnlyAuthentication": true,
          "login": "[variables('codeDeploymentIdentityName')]",
          "principalType": "Application",
          "sid": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), '2024-11-30').principalId]",
          "tenantId": "[subscription().tenantId]"
        },
        "minimalTlsVersion": "1.2",
        "publicNetworkAccess": "Disabled",
        "restrictOutboundNetworkAccess": "Disabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName'))]"
      ]
    },

    {
      "type": "Microsoft.Sql/servers/databases",
      "apiVersion": "2023-08-01",
      "name": "[format('{0}/{1}', variables('sqlServerName'), variables('sqlDatabaseName'))]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "S0",
        "tier": "Standard",
        "capacity": 10
      },
      "properties": {
        "autoPauseDelay": -1,
        "catalogCollation": "DATABASE_DEFAULT",
        "collation": "SQL_Latin1_General_CP1_CI_AS",
        "maxSizeBytes": 268435456000,
        "readScale": "Disabled",
        "requestedBackupStorageRedundancy": "Local",
        "zoneRedundant": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2024-06-01",
      "name": "[variables('sqlPrivateDnsZoneName')]",
      "location": "global",
      "tags": "[variables('tags')]"
    },

    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/primary-database-link', variables('sqlPrivateDnsZoneName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', variables('sqlPrivateDnsZoneName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-pe', variables('sqlServerName'))]",
      "location": "[parameters('primaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-connection', variables('sqlServerName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
              "groupIds": [
                "sqlServer"
              ],
              "privateLinkServiceConnectionState": {
                "status": "Approved",
                "description": "Approved by the Caldova Skillable deployment."
              }
            }
          }
        ],
        "subnet": {
          "id": "[variables('privateEndpointSubnetId')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}-pe/default', variables('sqlServerName'))]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "sql",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('sqlPrivateDnsZoneName'))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-pe', variables('sqlServerName')))]",
        "[resourceId('Microsoft.Network/privateDnsZones', variables('sqlPrivateDnsZoneName'))]"
      ]
    },

    {
      "type": "Microsoft.DataMigration/services",
      "apiVersion": "2025-06-30",
      "name": "[variables('migrationServiceName')]",
      "location": "[parameters('primaryLocation')]",
      "kind": "Cloud",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_1vCores",
        "tier": "Standard",
        "size": "1 vCores"
      },
      "properties": {
        "virtualSubnetId": "[variables('dmsSubnetId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('secondaryDatabaseVnetName')]",
      "location": "[parameters('secondaryLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.1.0.0/20"
          ]
        }
      }
    },

    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[variables('applicationVnetName')]",
      "location": "[parameters('applicationLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.20.0.0/20"
          ]
        },
        "subnets": [
          {
            "name": "snet-container-apps",
            "properties": {
              "addressPrefix": "10.20.0.0/23",
              "delegations": [
                {
                  "name": "container-apps",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          }
        ]
      }
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/app-to-database', variables('applicationVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/database-to-app', variables('secondaryDatabaseVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/application-to-primary-database', variables('applicationVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('applicationVnetName'), 'app-to-database')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/primary-database-to-application', variables('primaryDatabaseVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/primary-to-secondary', variables('primaryDatabaseVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('primaryDatabaseVnetName'), 'primary-database-to-application')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/virtualNetworks/virtualNetworkPeerings",
      "apiVersion": "2024-05-01",
      "name": "[format('{0}/secondary-to-primary', variables('secondaryDatabaseVnetName'))]",
      "properties": {
        "remoteVirtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
        },
        "allowVirtualNetworkAccess": true,
        "allowForwardedTraffic": false,
        "allowGatewayTransit": false,
        "useRemoteGateways": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('secondaryDatabaseVnetName'), 'database-to-app')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('primaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/secondary-database-link', variables('sqlPrivateDnsZoneName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('sqlPrivateDnsZoneName'), 'primary-database-link')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('secondaryDatabaseVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2024-06-01",
      "name": "[format('{0}/application-link', variables('sqlPrivateDnsZoneName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('sqlPrivateDnsZoneName'), 'secondary-database-link')]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('applicationVnetName'))]"
      ]
    },

    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('applicationLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      }
    },

    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[variables('containerAppsEnvironmentName')]",
      "location": "[parameters('applicationLocation')]",
      "tags": "[variables('tags')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        },
        "vnetConfiguration": {
          "infrastructureSubnetId": "[variables('containerAppsSubnetId')]",
          "internal": true
        },
        "workloadProfiles": [
          {
            "name": "Consumption",
            "workloadProfileType": "Consumption"
          }
        ],
        "zoneRedundant": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks/virtualNetworkPeerings', variables('applicationVnetName'), 'application-to-primary-database')]"
      ]
    },

    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('applicationLocation')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "placeholder",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": 0.5,
                "memory": "1Gi"
              },
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/",
                    "port": 8080
                  },
                  "initialDelaySeconds": 1,
                  "periodSeconds": 3,
                  "failureThreshold": 30
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/",
                    "port": 8080
                  },
                  "periodSeconds": 10,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/",
                    "port": 8080
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 2,
            "maxReplicas": 10,
            "rules": [
              {
                "name": "http-concurrency",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]"
      ]
    },

    {
      "type": "Microsoft.ContainerRegistry/registries/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('registryName'), guid(resourceId('Microsoft.ContainerRegistry/registries', variables('registryName')), resourceId('Microsoft.App/containerApps', variables('containerAppName')), variables('acrPullRoleDefinitionId')))]",
      "properties": {
        "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01', 'Full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('registryName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('containerAppName'))]"
      ]
    },

    {
      "type": "Microsoft.App/containerApps/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('containerAppName'), guid(resourceId('Microsoft.App/containerApps', variables('containerAppName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), variables('containerAppsContributorRoleDefinitionId')))]",
      "properties": {
        "roleDefinitionId": "[variables('containerAppsContributorRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('containerAppName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName'))]"
      ]
    },

    {
      "type": "Microsoft.Cdn/profiles",
      "apiVersion": "2024-02-01",
      "name": "[variables('frontDoorProfileName')]",
      "location": "global",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Premium_AzureFrontDoor"
      },
      "properties": {
        "originResponseTimeoutSeconds": 60
      }
    },

    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}', variables('frontDoorProfileName'), variables('frontDoorEndpointName'))]",
      "location": "global",
      "tags": "[variables('tags')]",
      "properties": {
        "enabledState": "Enabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorProfileName'))]"
      ]
    },

    {
      "type": "Microsoft.Cdn/profiles/originGroups",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}', variables('frontDoorProfileName'), variables('frontDoorOriginGroupName'))]",
      "properties": {
        "healthProbeSettings": {
          "probeIntervalInSeconds": 30,
          "probePath": "/",
          "probeProtocol": "Https",
          "probeRequestType": "HEAD"
        },
        "loadBalancingSettings": {
          "additionalLatencyInMilliseconds": 50,
          "sampleSize": 4,
          "successfulSamplesRequired": 3
        },
        "sessionAffinityState": "Disabled"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorProfileName'))]"
      ]
    },

    {
      "type": "Microsoft.Cdn/profiles/originGroups/origins",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}/{2}', variables('frontDoorProfileName'), variables('frontDoorOriginGroupName'), variables('frontDoorOriginName'))]",
      "properties": {
        "enabledState": "Enabled",
        "enforceCertificateNameCheck": true,
        "hostName": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn]",
        "httpPort": 80,
        "httpsPort": 443,
        "originHostHeader": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2024-03-01').configuration.ingress.fqdn]",
        "priority": 1,
        "sharedPrivateLinkResource": {
          "groupId": "managedEnvironments",
          "privateLink": {
            "id": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]"
          },
          "privateLinkLocation": "[parameters('applicationLocation')]",
          "requestMessage": "[variables('frontDoorPrivateLinkRequestMessage')]"
        },
        "weight": 1000
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('frontDoorProfileName'), variables('frontDoorOriginGroupName'))]",
        "[resourceId('Microsoft.App/containerApps', variables('containerAppName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppsEnvironmentName'))]"
      ]
    },

    {
      "type": "Microsoft.Cdn/profiles/afdEndpoints/routes",
      "apiVersion": "2024-02-01",
      "name": "[format('{0}/{1}/{2}', variables('frontDoorProfileName'), variables('frontDoorEndpointName'), variables('frontDoorRouteName'))]",
      "properties": {
        "enabledState": "Enabled",
        "forwardingProtocol": "HttpsOnly",
        "httpsRedirect": "Enabled",
        "linkToDefaultDomain": "Enabled",
        "originGroup": {
          "id": "[resourceId('Microsoft.Cdn/profiles/originGroups', variables('frontDoorProfileName'), variables('frontDoorOriginGroupName'))]"
        },
        "patternsToMatch": [
          "/*"
        ],
        "supportedProtocols": [
          "Http",
          "Https"
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles/afdEndpoints', variables('frontDoorProfileName'), variables('frontDoorEndpointName'))]",
        "[resourceId('Microsoft.Cdn/profiles/originGroups/origins', variables('frontDoorProfileName'), variables('frontDoorOriginGroupName'), variables('frontDoorOriginName'))]"
      ]
    },

    {
      "type": "Microsoft.Cdn/profiles/providers/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[format('{0}/Microsoft.Authorization/{1}', variables('frontDoorProfileName'), guid(resourceId('Microsoft.Cdn/profiles', variables('frontDoorProfileName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), variables('readerRoleDefinitionId')))]",
      "properties": {
        "roleDefinitionId": "[variables('readerRoleDefinitionId')]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName')), '2024-11-30').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Cdn/profiles', variables('frontDoorProfileName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('codeDeploymentIdentityName'))]"
      ]
    }
  ],

